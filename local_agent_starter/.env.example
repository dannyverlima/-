# Modelo textual principal
LOCAL_AGENT_MODEL=qwen3:8b
LOCAL_AGENT_BASE_URL=http://localhost:11434/v1
LOCAL_AGENT_API_KEY=ollama

# API multimodal opcional para transcricao e imagens
LOCAL_AGENT_MULTIMODAL_BASE_URL=https://api.openai.com/v1
LOCAL_AGENT_MULTIMODAL_API_KEY=
LOCAL_AGENT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LOCAL_AGENT_IMAGE_MODEL=gpt-image-1
LOCAL_AGENT_IMAGE_SIZE=1024x1024
LOCAL_AGENT_IMAGE_QUALITY=medium

# Workspace e memoria
LOCAL_AGENT_WORKSPACE=.
LOCAL_AGENT_DB=./data/agent_memory.sqlite3
LOCAL_AGENT_ARTIFACTS_DIR=./artifacts
LOCAL_AGENT_SITE_OUTPUT_DIR=./artifacts/sites
LOCAL_AGENT_IMAGE_OUTPUT_DIR=./artifacts/images
LOCAL_AGENT_AUDIO_OUTPUT_DIR=./artifacts/audio
LOCAL_AGENT_MONITOR_SNAPSHOT=./data/workspace_snapshot.json
LOCAL_AGENT_MAX_MEMORY_MESSAGES=14

# Permissoes e operacao
LOCAL_AGENT_ALLOW_WRITE=true
LOCAL_AGENT_ENABLE_SHELL=true
LOCAL_AGENT_SHELL_TIMEOUT_SECONDS=30
LOCAL_AGENT_HTTP_TIMEOUT_SECONDS=20
LOCAL_AGENT_SHELL_ALLOW_PREFIXES=Get-ChildItem,Get-Content,Get-Location,git status,git diff,git log,python --version,python -m http.server
LOCAL_AGENT_MONITOR_IGNORE_NAMES=.git,.venv,__pycache__,.pytest_cache

# Voz
LOCAL_AGENT_DEFAULT_RECORD_SECONDS=6
LOCAL_AGENT_TTS_RATE=185
LOCAL_AGENT_TTS_VOICE_HINT=
